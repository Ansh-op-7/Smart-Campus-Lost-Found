# =======================================================
# FindIt - Docker Compose & Platform Environment Variables
# =======================================================
# Copy this file to '.env' before running 'docker compose up --build'

# MySQL Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=findit_db
MYSQL_USER=findit_user
MYSQL_PASSWORD=findit_password

# Backend Configuration
SERVER_PORT=8080
DB_URL=jdbc:mysql://mysql:3306/findit_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
DB_USERNAME=findit_user
DB_PASSWORD=findit_password
JWT_SECRET=replace_with_a_production_random_secret_at_least_256_bits
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:80
APP_UPLOAD_DIR=uploads/items

# Frontend Configuration
VITE_API_URL=http://localhost:8080
